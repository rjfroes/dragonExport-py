# Copy this file to .env and fill in values
# Never commit the .env file

# Google Sheets
SHEET_NAME=MTG Dragons Tracker

# Scryfall API
SCRYFALL_QUERY=t:dragon game:paper
SCRYFALL_UNIQUE=prints

# HTTP resilience
HTTP_TIMEOUT=30
MAX_PAGES=200
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BACKOFF=2

# Fixed USD -> BRL exchange rate
CURRENCY_RATE_BRL=5.0

# Authentication file paths (relative to project root)
CREDENTIALS_FILE=credentials.json
TOKEN_FILE=token.pickle

# Logging
LOG_LEVEL=INFO
